# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Speech-to-Text (STT) Provider
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Vector Database (RAG) & Embeddings
# Leave QDRANT_URL empty to use zero-config local embedded storage (qdrant_storage)
QDRANT_URL=
QDRANT_PATH=qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=sahayak_kb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Large Language Model (LLM)
GROQ_API_KEY=
GEMINI_API_KEY=

# Text-to-Speech (TTS) Provider
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Web Search
TAVILY_API_KEY=
