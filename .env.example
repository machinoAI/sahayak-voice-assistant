# ==============================================================================
# Sahayak AI Voice Assistant - Environment Configuration Template
# Copy this file to '.env' and populate your provider API keys as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Execution Profile
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Execution Profile:
#   - 'production': Cloud-hosted low-latency providers (Groq, Deepgram, Cartesia, ElevenLabs)
#   - 'local'     : Zero-cost self-hosted setup (Local Whisper, Ollama, Edge-TTS)
VOICE_PROFILE=production

# ------------------------------------------------------------------------------
# 2. Multi-Provider Default Selection & Automated Failover Chains
# ------------------------------------------------------------------------------
# Active primary providers at startup:
ACTIVE_STT_PROVIDER=deepgram    # deepgram | sarvam | whisper
ACTIVE_LLM_PROVIDER=groq        # groq | gemini | openai | anthropic | ollama
ACTIVE_TTS_PROVIDER=cartesia    # cartesia | elevenlabs | edge
TTS_PROVIDER=cartesia           # Legacy backward-compatibility alias

# Failover fallback sequences (in order of priority on network timeout, 429, or quota error):
LLM_FAILOVER_CHAIN=["groq", "gemini", "openai"]
TTS_FAILOVER_CHAIN=["cartesia", "elevenlabs", "edge"]
STT_FAILOVER_CHAIN=["deepgram", "sarvam"]

FAILOVER_COOLDOWN_SECONDS=60.0
FAILOVER_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (STT) Providers
# ------------------------------------------------------------------------------
# Deepgram Nova-2 (Default Streaming WebSocket STT)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-IN
DEFAULT_LANGUAGE=auto           # auto | en | hi

# Sarvam AI (Specialized Indian Multilingual & Indic ASR)
SARVAM_API_KEY=

# Local / Self-Hosted Whisper (Zero-cost offline ASR via faster-whisper)
LOCAL_WHISPER_MODEL=base        # tiny | base | small | medium

# ------------------------------------------------------------------------------
# 4. Large Language Model (LLM) Providers
# ------------------------------------------------------------------------------
# 1. Groq LPU (Ultra-Low Latency Streaming Inference)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b  # or llama-3.3-70b-versatile

# 2. Google Gemini (google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# 3. OpenAI (Official OpenAI API or custom OpenAI-compatible proxies)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# 4. Anthropic Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 5. Local / Ollama (OpenAI-compatible local endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 5. Text-to-Speech (TTS) Providers
# ------------------------------------------------------------------------------
# 1. Cartesia Sonic (Sub-100ms ultra-low latency PCM streaming)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# 2. Microsoft Edge-TTS (Zero-cost neural multilingual / Indic voices)
EDGE_VOICE=en-IN-NeerjaNeural
EDGE_TTS_INDIC_VOICE=hi-IN-SwaraNeural

# 3. ElevenLabs (Turbo v2.5 / Flash v2.5 high-naturalness conversational speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ------------------------------------------------------------------------------
# 6. Vector Database (Qdrant) & Embeddings
# ------------------------------------------------------------------------------
# Leave QDRANT_URL empty to use zero-config local embedded storage (qdrant_storage)
QDRANT_URL=
QDRANT_PATH=qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=sahayak_kb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ------------------------------------------------------------------------------
# 7. Corrective RAG (CRAG) & External Web Search
# ------------------------------------------------------------------------------
# Tavily Search API (Used when vector retrieval confidence is below high threshold)
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=2
WEB_SEARCH_TIMEOUT_SECONDS=4.0

# Dynamic Retrieval Routing & Confidence Thresholds
CRAG_HIGH_THRESHOLD=0.82
CRAG_LOW_THRESHOLD=0.55
SEMANTIC_ROUTER_ENABLED=true
